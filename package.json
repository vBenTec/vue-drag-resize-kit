{
  "name": "vue-drag-resize-kit",
  "version": "1.3.0",
  "private": false,
  "description": "Draggable and resizable component for Vue 3, with snapping, alignment guides and full TypeScript support.",
  "keywords": [
    "component",
    "draggable",
    "resizable",
    "snapping",
    "vue",
    "vue3"
  ],
  "homepage": "https://vbentec.github.io/vue-drag-resize-kit/",
  "bugs": {
    "url": "https://github.com/vBenTec/vue-drag-resize-kit/issues"
  },
  "license": "MIT",
  "author": "Benjamin Scharf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vBenTec/vue-drag-resize-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev-vue": "vite",
    "serve": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "build": "vite build && rolldown -c rolldown.dts.config.ts",
    "check:pkg": "publint && attw --pack --profile esm-only --exclude-entrypoints style.css",
    "prepublishOnly": "pnpm build && pnpm check:pkg",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:screenshot": "node docs/.vitepress/screenshot.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "^4.14.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "rolldown": "^1.3.2",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "1.15.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,css,yml,yaml,html}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.20.0"
}
