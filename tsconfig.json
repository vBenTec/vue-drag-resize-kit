{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "noEmit": true,
    // The docs demos import the package by name; type-check them against the source.
    "paths": {
      "vue-drag-resize-kit": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "playground",
    "docs/.vitepress/*.ts",
    "docs/.vitepress/theme",
    "docs/demos",
    "vite.config.ts",
    "rolldown.dts.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
