{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {},
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["vue", "vue/*", "@vue/*", "@vueuse/*", "vue-demi", "**/vue/**"],
                "message": "src/core is framework-agnostic: no Vue imports."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "docs/.vitepress/cache", "docs/.vitepress/dist"]
}
